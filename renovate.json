{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the Meilisearch image tag in the Unraid CA template",
      "managerFilePatterns": ["/(^|/)meilisearch\\.xml$/"],
      "matchStrings": [
        "<Repository>getmeili/meilisearch:(?<currentValue>v?[\\d.]+)</Repository>"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "getmeili/meilisearch",
      "versioningTemplate": "docker"
    }
  ]
}
